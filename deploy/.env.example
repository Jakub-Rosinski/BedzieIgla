# VPS-local secrets — copy this to /home/deploy/bedzieigla/.env on the server
# and fill in real values. NEVER commit the real .env, never pass these
# through GitHub Actions — they're read from process.env at runtime
# (src/lib/server/mailer.js), loaded by `-r dotenv/config` (see ecosystem.config.js).

# SMTP must be OVH's, not Gmail's. The domain's SPF record is
# "v=spf1 include:mx.ovh.com -all" — the trailing "-all" is a HARD fail, so a
# message sent from Google's servers with From: @bedzieigla.pl gets rejected
# outright, not just spam-foldered. mailer.js derives From from SMTP_USER, so
# SMTP_USER has to be a real mailbox in this domain (not a forwarding alias —
# an alias has no password and cannot authenticate).
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_USER=kontakt@bedzieigla.pl
SMTP_PASS=
# Where Gosia actually reads her mail.
CONTACT_TO_EMAIL=
