# ─── Google Analytics 4 ───────────────────────────────────────────────────────
# Measurement ID z analytics.google.com → Admin → Strumienie danych → Web
# Pozostaw puste aby wyłączyć analytics (np. w środowisku dev)
VITE_GA4_ID=G-XXXXXXXXXX

# ─── SMTP (formularz kontaktowy — serwer) ────────────────────────────────────
# Serwerowe (BEZ prefiksu VITE_ — nigdy nie trafiają do builda klienta).
# W produkcji ustawiane wyłącznie na VPS (patrz deploy/.env.example), nigdy w CI.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=

# ─── OVH S3 (galeria zdjęć) ───────────────────────────────────────────────────
# URL do listowania bucketa (S3 ListObjectsV2).
# Bucket musi mieć publiczną politykę: s3:ListBucket dla Principal "*".
# Przykład: https://s3.waw.perf.cloud.ovh.net/bedzie-igla
VITE_S3_LIST_URL=

# Bazowy publiczny URL dla dostępu do obiektów (bez trailing slash).
# Przykład: https://bedzie-igla.s3.waw.perf.cloud.ovh.net
VITE_S3_PUBLIC_URL=

# Prefix folderu ze zdjęciami w buckecie (domyślnie: gallery/).
VITE_S3_PREFIX=gallery/
